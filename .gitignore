# ============================================================
#  Monorepo .gitignore — both sides.
#
#  Patterns without a leading slash match at any depth, so the build
#  output rules below cover desktop/ and android/ alike. The .NET rules
#  come first, the Gradle/Android ones at the end.
# ============================================================

# ----- Build output -----
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
# The Android logging package is source code, not generated output.
!android/**/util/log/

# ----- Visual Studio files -----
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
.vscode/

# ----- NuGet -----
*.nupkg
*.snupkg
**/[Pp]ackages/
!**/[Pp]ackages/build/
*.lock.json
project.lock.json
packages.lock.json
nuget.dgspec.json

# ----- Roslyn / MSBuild generated -----
*.g.cs
*.g.i.cs
GlobalUsings.g.cs
AssemblyAttributes.cs.bak

# ----- Test results -----
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage*/

# ----- Publish / deployment -----
publish/
**/Properties/PublishProfiles/

# ----- Gradle / Android (android/) -----
# `build/` has no leading slash on purpose — it matches android/build/ and
# android/app/build/ alike, and the desktop side builds into bin/ and obj/, so
# nothing of its is caught by it.
.gradle/
build/
.kotlin/
.cxx/
captures/
local.properties
*.apk
*.aab
*.aar
*.keystore
*.jks
# The wrapper JAR is the one binary that belongs in the repository: without it
# `./gradlew` cannot bootstrap, which is the whole point of a wrapper.
!gradle/wrapper/gradle-wrapper.jar

# ----- Rider / IntelliJ / Android Studio -----
.idea/
*.sln.iml
*.iml

# ----- OS generated -----
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ----- Secrets / sensitive config -----
appsettings.Development.json
appsettings.Local.json
secrets.json
*.pfx
*.p12
*.key

# ----- Crash dumps -----
*.dmp
*.mdmp

.bugs-resueltos/
.claude/
.codex/
.docs/
releases/
