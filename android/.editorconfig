# EditorConfig — Android side (Kotlin, Gradle, Android resources).
#
# Deliberately omits `root`, so it inherits the monorepo baseline at
# ../.editorconfig (UTF-8, CRLF, 4-space indent, trimmed trailing whitespace,
# final newline). Only rules specific to this side's languages live here.
#
# This file configures the IDE. It does NOT configure the formatting gate:
# Spotless' ktlint step does not read it (see the comment on `ktlintSettings` in
# build.gradle.kts, which is where the gate's copy of these values lives). The
# ktlint_* keys below are duplicated there on purpose so the IDE and the gate
# format alike — change one, change the other.

[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = intellij_idea
ktlint_function_naming_ignore_when_annotated_with = Composable

# Import order is alphabetical with no groupings and no wildcards, matching the
# desktop rule that `using` directives are neither System-first nor grouped.
ij_kotlin_imports_layout = *
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# Shell scripts are LF or they do not run on the Linux CI runner. `gradlew` is
# generated by Gradle and must never be "fixed" to CRLF; see ../.gitattributes,
# which enforces the same thing at the Git level for anyone whose editor
# ignores this file.
[{gradlew,*.sh}]
end_of_line = lf

[*.{yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 4
