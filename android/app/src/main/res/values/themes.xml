<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LostieLauncher" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/volcarona_primary_bg</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.LostieLauncher.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/volcarona_primary_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">@integer/splash_icon_animation_duration</item>
        <item name="postSplashScreenTheme">@style/Theme.LostieLauncher</item>
    </style>

    <style name="Theme.LostieLauncher.Splash.Zoroark">
        <item name="windowSplashScreenBackground">@color/zoroark_primary_bg</item>
    </style>

    <style name="Theme.LostieLauncher.Splash.Infernape">
        <item name="windowSplashScreenBackground">@color/infernape_primary_bg</item>
    </style>

    <style name="Theme.LostieLauncher.Splash.Torterra">
        <item name="windowSplashScreenBackground">@color/torterra_primary_bg</item>
    </style>

    <style name="Theme.LostieLauncher.Splash.Empoleon">
        <item name="windowSplashScreenBackground">@color/empoleon_primary_bg</item>
    </style>

    <style name="Theme.LostieLauncher.Splash.Mewtwo">
        <item name="windowSplashScreenBackground">@color/mewtwo_primary_bg</item>
    </style>

    <style name="Theme.LostieLauncher.Splash.Cefireon">
        <item name="windowSplashScreenBackground">@color/cefireon_primary_bg</item>
    </style>

    <style name="Theme.LostieLauncher.Splash.Sylveon">
        <item name="windowSplashScreenBackground">@color/sylveon_primary_bg</item>
    </style>

    <style name="Theme.LostieLauncher.Splash.Astrem">
        <item name="windowSplashScreenBackground">@color/astrem_primary_bg</item>
    </style>

    <style name="Theme.LostieLauncher.Splash.Auretoskos">
        <item name="windowSplashScreenBackground">@color/auretoskos_primary_bg</item>
    </style>
</resources>
