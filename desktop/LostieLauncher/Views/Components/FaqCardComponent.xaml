<UserControl x:Class="LostieLauncher.Views.Components.FaqCardComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="FaqLinkStyle" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryFgBrush}" />
            <Setter Property="TextDecorations" Value="Underline" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryFgHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource OverlaySubtleBrush}" CornerRadius="8" Margin="0,0,0,10">
        <StackPanel>
            <Border Background="Transparent" Padding="16" Cursor="Hand"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <iconPacks:PackIconLucide Kind="CircleQuestionMark" Width="16" Height="16"
                                              Foreground="{DynamicResource PrimaryFgBrush}"
                                              VerticalAlignment="Center" Margin="0,0,10,0" />

                    <TextBlock x:Name="QuestionText" Grid.Column="1"
                               Foreground="{DynamicResource SecondaryFgBrush}"
                               FontSize="14" FontWeight="SemiBold"
                               TextWrapping="Wrap" VerticalAlignment="Center" />

                    <iconPacks:PackIconLucide Grid.Column="2" Kind="ChevronDown" Width="16" Height="16"
                                              Foreground="{DynamicResource SecondaryFgDimBrush}"
                                              VerticalAlignment="Center" Margin="10,0,0,0"
                                              RenderTransformOrigin="0.5,0.5">
                        <iconPacks:PackIconLucide.Style>
                            <Style TargetType="iconPacks:PackIconLucide">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="0" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded, ElementName=Root}" Value="True">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="180" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconLucide.Style>
                    </iconPacks:PackIconLucide>
                </Grid>
            </Border>

            <StackPanel Visibility="{Binding IsExpanded, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Height="1" Background="{DynamicResource OverlayLightBrush}" Margin="16,0" />
                <TextBlock x:Name="AnswerText" Margin="16,12,16,16"
                           Foreground="{DynamicResource SecondaryFgDimBrush}"
                           FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
