# EditorConfig — https://editorconfig.org
#
# Monorepo-wide baseline. Only rules that apply to *every* file in the
# repository live here. Language-specific rules belong next to the side that
# owns the language:
#
#   desktop/.editorconfig   C#, XAML and MSBuild files
#   android/.editorconfig   Kotlin and Gradle files (added with the project)
#
# Those files intentionally omit `root`, so they inherit everything below.
root = true

# ── Todos los archivos ──────────────────────────────────────────────────────
[*]
charset                  = utf-8
end_of_line              = crlf
indent_style             = space
indent_size              = 4
trim_trailing_whitespace = true
insert_final_newline     = true

# ── Markdown ─────────────────────────────────────────────────────────────────
[*.md]
trim_trailing_whitespace = false
